{
  "schemaVersion": 1,
  "id": "ryuhzk.ime",
  "name": "输入法",
  "version": "0.1.0",
  "author": "ryuhzk",
  "license": "MIT",
  "description": "从状态栏掌管整个输入法：Fcitx5、Rime 和候选词注释。",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "输入法",
    "description": "实时输入状态、schema 切换，以及所有 Fcitx5 和 Rime 设置，都在一处。",
    "category": "系统",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "schemas": ["rime_ice"],
      "annotation": false,
      "annotateChinese": true,
      "annotateEnglish": true,
      "annotateShowPinyin": false,
      "annotateHotkey": "Control+e",
      "traditionalize": true,
      "qtImModule": true,
      "pageSize": 10,
      "verticalCandidates": true,
      "backgroundImageLight": "",
      "backgroundImageDark": "",
      "panelWidth": 420
    },
    "schema": [
      {
        "key": "schemas",
        "type": "multiselect",
        "label": "输入方案",
        "description": "部署哪些 Rime schema，按 Rime 提供的顺序。每个选项列在其所属类别下；选项自己的 id 是 Rime 对它的称呼，面板会在旁边显示每个 schema 的可读名称。至少保留一个中文 schema。",
        "noSelectionText": "仅 Rime Ice",
        "placeholderText": "搜索 schema...",
        "emptyText": "无 schema",
        "defaultValue": ["rime_ice"],
        "options": [
          {
            "value": "rime_ice",
            "description": "全拼"
          },
          {
            "value": "luna_pinyin",
            "description": "全拼"
          },
          {
            "value": "luna_quanpin",
            "description": "全拼"
          },
          {
            "value": "luna_pinyin_simp",
            "description": "全拼"
          },
          {
            "value": "luna_pinyin_tw",
            "description": "全拼"
          },
          {
            "value": "luna_pinyin_fluency",
            "description": "全拼"
          },
          {
            "value": "double_pinyin",
            "description": "双拼"
          },
          {
            "value": "double_pinyin_flypy",
            "description": "双拼"
          },
          {
            "value": "double_pinyin_mspy",
            "description": "双拼"
          },
          {
            "value": "double_pinyin_sogou",
            "description": "双拼"
          },
          {
            "value": "double_pinyin_jiajia",
            "description": "双拼"
          },
          {
            "value": "double_pinyin_ziguang",
            "description": "双拼"
          },
          {
            "value": "double_pinyin_abc",
            "description": "双拼"
          },
          {
            "value": "bopomofo",
            "description": "注音"
          },
          {
            "value": "bopomofo_tw",
            "description": "注音"
          },
          {
            "value": "bopomofo_express",
            "description": "注音"
          },
          {
            "value": "cangjie5",
            "description": "形码"
          },
          {
            "value": "cangjie5_express",
            "description": "形码"
          },
          {
            "value": "radical_pinyin",
            "description": "形码"
          },
          {
            "value": "terra_pinyin",
            "description": "其他"
          },
          {
            "value": "terra_pinyin_12345",
            "description": "其他"
          },
          {
            "value": "japanese_tw_eng",
            "description": "日语"
          },
          {
            "value": "sno_japanese",
            "description": "日语"
          }
        ]
      },
      {
        "key": "annotation",
        "type": "boolean",
        "label": "候选词注释",
        "defaultValue": false,
        "description": "候选词旁的释义，从 CC-CEDICT 读取：中文候选词上标英文含义，英文候选词上标中文含义，组字时用热键显示和隐藏。默认关闭。关闭时不安装 Lua 过滤器、不下载词典，也不向任何 schema 写入注释过滤器、开关或热键绑定；下面四个释义设置在重新打开时会保留其值。"
      },
      {
        "key": "annotateChinese",
        "type": "boolean",
        "label": "中文候选词标英文",
        "defaultValue": true,
        "description": "显示中文候选词的英文含义。"
      },
      {
        "key": "annotateEnglish",
        "type": "boolean",
        "label": "英文候选词标中文",
        "defaultValue": true,
        "description": "显示英文候选词的中文含义。"
      },
      {
        "key": "annotateShowPinyin",
        "type": "boolean",
        "label": "释义中带拼音",
        "defaultValue": false,
        "description": "在释义前加上候选词的拼音。默认关闭：释义才是这个功能的意义，而拼音已经在你刚输入的内容里了。"
      },
      {
        "key": "annotateHotkey",
        "type": "string",
        "label": "注释热键",
        "defaultValue": "Control+e",
        "description": "组字时切换释义。它在其他地方保持空闲，因此终端保留自己对这个键的绑定。"
      },
      {
        "key": "traditionalize",
        "type": "boolean",
        "label": "繁体输出",
        "defaultValue": true,
        "description": "使用 s2twp 配置将输出转换为繁体中文。"
      },
      {
        "key": "pageSize",
        "type": "integer",
        "label": "每页候选词数",
        "min": 1,
        "max": 10,
        "step": 1,
        "defaultValue": 10,
        "description": "Rime 一次显示多少个候选词。"
      },
      {
        "key": "verticalCandidates",
        "type": "boolean",
        "label": "候选词竖排",
        "defaultValue": true,
        "description": "候选词垂直堆叠，而不是排成一行。"
      },
      {
        "key": "qtImModule",
        "type": "boolean",
        "label": "XWayland Qt 应用的输入法",
        "defaultValue": true,
        "description": "设置 QT_IM_MODULE=fcitx，让 XWayland Qt 应用（如微信）能输入中文。只有在原生 Wayland Qt 表面行为异常时才关闭它。下次登录时生效。"
      },
      {
        "key": "backgroundImageLight",
        "type": "string",
        "label": "浅色主题背景",
        "defaultValue": "",
        "description": "浅色 Omarchy 主题活动时绘制在候选词后面的图像的绝对路径。留空则使用主题自己的背景色。接受 .png、.svg、.svgz、.jpg、.jpeg、.jpe、.webp、.bmp 和 .gif。图像会替换生成的面板而非给它着色，因此只有文件无法加载时才会显示主题颜色。"
      },
      {
        "key": "backgroundImageDark",
        "type": "string",
        "label": "深色主题背景",
        "defaultValue": "",
        "description": "深色 Omarchy 主题活动时绘制在候选词后面的图像的绝对路径。留空则使用主题自己的背景色。用两张图像而非一张，因为针对深色主题挑选的图像在浅色下不可读，而候选词窗口跟随切换到的主题。"
      },
      {
        "key": "panelWidth",
        "type": "integer",
        "label": "面板宽度",
        "min": 400,
        "max": 720,
        "step": 10,
        "defaultValue": 420,
        "description": "弹出面板的宽度，以布局单位计。下限是每个设置标签仍能在其控件旁完整显示而不省略的最窄面板。"
      }
    ]
  }
}